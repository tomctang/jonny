Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "m"], "(", "n", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"m", "+", "1"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["B", "0"], 
          SuperscriptBox["n", 
           RowBox[{"m", "+", "1"}]]}], "+", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{"m", "+", "1"}]},
             {"1"}
            }], ")"}], 
          SubscriptBox["B", "1"], 
          SuperscriptBox["n", "m"]}], "+"}], "..."}], "+", 
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            RowBox[{"m", "+", "1"}]},
           {"m"}
          }], ")"}], 
        SubscriptBox["B", "m"], "n"}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ecc36eae-2469-49ba-a505-817b4844822b"],
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "m"], "(", "n", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"m", "+", "1"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], "m"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            RowBox[{"m", "+", "1"}]},
           {"k"}
          }], ")"}], 
        SubscriptBox["B", "k"], 
        SuperscriptBox["n", 
         RowBox[{"(", 
          RowBox[{"m", "+", "1", "-", "k"}], ")"}]]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"55b98fc8-b93b-4d97-a710-66f8b23d6803"]
}], "Text",
