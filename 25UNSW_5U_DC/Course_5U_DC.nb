}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["14. Convergence Tests", "Chapter",
 CellChangeTimes->{{3.984333326754389*^9, 3.984333327634289*^9}, {
  3.984333384212233*^9, 
  3.984333386932029*^9}},ExpressionUUID->"be0fb994-4bd3-4289-ac66-\
1e9fb655f44a"],

Cell[TextData[{
 "Based on our earlier definition of convergence, a series is only convergent \
if the terms approach 0. \nBut, if the terms approach 0, this tells us \
nothing, as the sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         FractionBox["1", 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{n=0}^\\infty\\frac1n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cec0ce05-3e67-429f-9c2a-0ed44bd10334"],
 " has terms that approach 0, even though it is divergent. \nThis test is \
only designed for checking some divergent series.\n"
}], "Text",
 CellChangeTimes->{{3.9843333928282967`*^9, 3.984333466590559*^9}, {
   3.9843335159287777`*^9, 3.9843335287531757`*^9}, {3.9843339575900373`*^9, 
   3.9843340110295677`*^9}, {3.984334049045414*^9, 3.984334160485941*^9}, 
   3.984334259774617*^9, {3.984349106001377*^9, 
   3.984349113057003*^9}},ExpressionUUID->"ade91e8a-8b28-4918-8156-\
ec154854a51c"],

Cell[TextData[{
 StyleBox["Integral",
  FontWeight->"Bold"],
 " test\nIntegral: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     SubscriptBox["n", "0"], "\[Infinity]"], 
    RowBox[{
     RowBox[{"a", "(", "x", ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "1e2c476e-df79-4da4-bef0-d876e37fd977"]
}], "Text",
 CellChangeTimes->{{3.984334162294692*^9, 3.984334184061928*^9}, {
  3.9843350353430443`*^9, 
  3.984335037134582*^9}},ExpressionUUID->"3181381e-40a7-4ccd-a54c-\
7d82318b83e1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["n", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "n_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9a479dd-b916-40d4-88f9-30b26428899b"],
 " must be a natural number."
}], "Item",
 CellChangeTimes->{{3.984334194735332*^9, 
  3.984334217104866*^9}},ExpressionUUID->"2dead0c3-8ad2-4826-a572-\
cbf1e164d6d6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b0795d8-bcaf-4fa0-9a26-64dfbca2747a"],
 " must decrease as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4c00ba8-513a-410a-9bfa-98f0409c46f8"],
 " increases."
}], "Item",
 CellChangeTimes->{{3.984334194735332*^9, 
  3.984334229038198*^9}},ExpressionUUID->"b7568c78-0f7d-4df7-b969-\
11ff105a66db"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed9f52de-f37d-4b3e-a619-68374ff3f497"],
 " must be positive for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LessEqual]", 
         SubscriptBox[
          StyleBox["n", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "x\\leq n_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce8672ed-6aff-47c7-835b-109c7d7f3e10"],
 "."
}], "Item",
 CellChangeTimes->{{3.984334194735332*^9, 
  3.984334232823876*^9}},ExpressionUUID->"631a12f2-0e86-498d-84df-\
09467291e5f5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a73446e-4c54-43ce-98d5-879e903d9781"],
 " must be continuous for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[GreaterEqual]", 
         SubscriptBox[
          StyleBox["n", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "x\\geq n_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d6e2370-302d-4b50-aa38-6ee728d74d59"],
 "."
}], "Item",
 CellChangeTimes->{{3.984334194735332*^9, 3.984334255038262*^9}, 
   3.984349064012115*^9},ExpressionUUID->"796f6efa-5b8d-43c9-84f0-\
f41eac7a16d0"],

Cell[TextData[{
 StyleBox["\nLimit comparison",
  FontWeight->"Bold"],
 " test\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         UnderscriptBox["lim", 
          RowBox[{
            StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}], 
          LimitsPositioning -> True], 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["n", "TI"]], 
          SubscriptBox[
           StyleBox["b", "TI"], 
           StyleBox["n", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L=\\lim_{n\\rightarrow\\infty}\\frac{a_n}{b_n}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0dfe44f-88b4-4dc0-bfd1-083871499f90"],
 "\nIf ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L\\ne0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3078d54-8d54-4661-a8b3-e4faa8bc7e8e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["b", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "b_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0878b97d-3383-4299-aca3-43faa7b2343f"],
 " is divergent, then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e069295-24e0-4ddd-98b5-bb30861e65ff"],
 " is also divergent.\nOtherwise, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d8d6306-999d-4ca7-923d-3cbe5a58a039"],
 " is convergent."
}], "Text",
 CellChangeTimes->{{3.984334534674508*^9, 3.984334542275579*^9}, {
   3.984334596027438*^9, 3.984334647037328*^9}, 
   3.984349066824428*^9},ExpressionUUID->"6c444373-279c-46ea-90ba-\
c988e7ab01ac"],

Cell[TextData[{
 StyleBox["\nAlternating Series",
  FontWeight->"Bold"],
 " Test\nSum: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          StyleBox["n", "TI"]], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{n=0}^\\infty(-1)^nA_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce3a9b39-9a09-4435-912e-68ec8826747f"],
 "\nConditions: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "A_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5490cf95-a3eb-47fe-9bb0-30db0a7ee1b3"],
 " is non-negative for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[GreaterEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n\\geq1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "74a7dd0f-6d7b-4cb9-a9d3-d4d1ec62bf15"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "A_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33e753c5-70f8-49b9-bfea-97bcb32cc1b5"],
 " is monotone decreasing(never increasing), and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["lim", 
          RowBox[{
            StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\lim_{n\\rightarrow\\infty}A_n=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62dc221d-ae29-4e45-b4c8-c63253c1372f"],
 ".\nIf all conditions hold, then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          StyleBox["n", "TI"]], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{n=0}^\\infty(-1)^nA_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b95f237-5a54-46e1-80a8-0d6a70b168b2"],
 " converges."
}], "Text",
 CellChangeTimes->{{3.9843349232917967`*^9, 3.984335065077876*^9}, {
   3.984335112025041*^9, 3.984335127521649*^9}, 
   3.9843490693446007`*^9},ExpressionUUID->"6c16b9b3-1cc3-4e53-833d-\
c32271812e1c"],

Cell[TextData[{
 StyleBox["Ratio ",
  FontWeight->"Bold"],
 "Test\nThe ratio test states that if the absolute value of the ratio between \
one term and the next is larger than 1(the series is increasing), then the \
series will diverge. Similarly, if it is less than 1, then the series will \
converge.\nIf the ratio is 1(no change between terms), then no conclusion can \
be made."
}], "Text",
 CellChangeTimes->{{3.984335373906146*^9, 3.984335447418867*^9}, {
  3.984335530789312*^9, 
  3.984335550678479*^9}},ExpressionUUID->"6794a941-0b93-4480-832c-\
fa146300feba"]
}, Closed]],

Cell[CellGroupData[{

Cell["15. Volume of N-D sphere", "Chapter",
 CellChangeTimes->{{3.984353895603745*^9, 
  3.984353907723755*^9}},ExpressionUUID->"4d269151-123d-4628-ab5c-\
4cd55f5b035c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "Circular", ",", " ", "r", ",", " ", "s", ",", " ", "t", ",", " ", "x"}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Circular", "[", 
    RowBox[{"r_", ",", " ", "t_"}], "]"}], " ", "=", " ", 
   RowBox[{"r", " ", "*", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SandT", " ", "=", " ", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"Circular", "[", 
      RowBox[{"1", ",", " ", "x"}], "]"}], " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", 
       FractionBox["\[Pi]", "3"]}], "}"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], ",", " ", 
     RowBox[{"AxesStyle", "->", "Thick"}], ",", " ", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Labels", " ", "=", " ", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"FontSize", " ", "->", " ", "30"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.45", ",", " ", "0.35"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"r", ",", " ", 
          RowBox[{"FontSize", " ", "->", " ", "30"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.25", ",", " ", "0.5"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ExtendedAxis", " ", "=", " ", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Circular", "[", 
       RowBox[{"0.5", ",", " ", "x"}], "]"}], "}"}], " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", 
       FractionBox["\[Pi]", "3"]}], "}"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ",", " ", 
     RowBox[{"AxesStyle", "->", "Thick"}], ",", " ", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Dotted", ",", "Red"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Dotted", ",", "Red"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ExtendedAxis2", " ", "=", " ", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Circular", "[", 
       RowBox[{"1", ",", " ", "x"}], "]"}], "}"}], " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], "/", "6"}], ",", " ", 
       FractionBox["\[Pi]", "2"]}], "}"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ",", " ", 
     RowBox[{"AxesStyle", "->", "Thick"}], ",", " ", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Dotted", ",", "Red"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Dotted", ",", "Red"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LinesPlot", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Thick", ",", " ", "Blue", ",", " ", 
       RowBox[{"Line", "[", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", " ", 
          RowBox[{"Circular", "[", 
           RowBox[{"1", ",", " ", 
            FractionBox["\[Pi]", "3"]}], "]"}]}], "}"}], "]"}]}], "}"}], 
     "]"}], "}"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", " ", 
  RowBox[{
  "SandT", ",", " ", "Labels", ",", " ", "ExtendedAxis", ",", " ", 
   "ExtendedAxis2", ",", " ", "LinesPlot", ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"ViewPoint", "->", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "3", ",", " ", "3"}], "}"}]}]}], "]"}]}], "Code",
 CellChangeTimes->{3.984353996243773*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"9526f501-7a87-4c67-88cb-ad400968a954"],

