Cell[CellGroupData[{

Cell["5. Permutations and Combinations", "Chapter",
 CellChangeTimes->{{3.982122732830823*^9, 
  3.9821227397138166`*^9}},ExpressionUUID->"8b8e0844-1e83-4e04-b010-\
e8bf64c7a4db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Perm", "[", 
    RowBox[{"n_", ",", "k_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"n", "!"}], "/", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "-", "k"}], ")"}], "!"}]}]}], ";"}], "\n", 
 RowBox[{"Perm", "[", 
  RowBox[{"11", ",", "11"}], "]"}]}], "Code",
 CellChangeTimes->{{3.9821227758992863`*^9, 3.9821227804908543`*^9}, {
  3.982122844048085*^9, 3.98212292037293*^9}, {3.982123014537812*^9, 
  3.9821230150736*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"551243b1-f948-44f1-87e4-10bd147fbdc7"],

Cell[BoxData["39916800"], "Output",
 CellChangeTimes->{
  3.982122780866171*^9, {3.98212284960892*^9, 3.982122920581832*^9}, 
   3.98212295272346*^9, 3.9821230154261713`*^9},
 CellLabel->"Out[89]=",ExpressionUUID->"f757ef85-ec8e-496d-b6b4-43610e6aa0ef"]
}, Open  ]],

