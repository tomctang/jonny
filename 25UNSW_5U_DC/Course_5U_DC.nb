      RowBox[{
       RowBox[{
        RowBox[{"Binomial", "[", 
         RowBox[{"k", ",", " ", "v"}], "]"}], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "v"], "*", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"v", "+", "1"}], ")"}], "n"], 
         RowBox[{"k", "+", "1"}]]}], ",", " ", 
