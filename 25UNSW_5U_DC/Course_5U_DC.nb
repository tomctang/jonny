70e4dc6991f9"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "x"], 
    RowBox[{
     RowBox[{"f", "(", "t", ")"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     FractionBox["1", "n"], 
     SubscriptBox["g", 
      RowBox[{"n", "-", "1"}]], 
     SuperscriptBox["x", "n"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"46e973c4-5955-4250-9731-803f7aba2332"]], \
