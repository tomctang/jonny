 FormBox[
  RowBox[{
   RowBox[{"x", " ", 
    RowBox[{"F", "'"}], 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
