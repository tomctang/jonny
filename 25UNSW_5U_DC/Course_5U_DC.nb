 RowBox[{
  UnderoverscriptBox["\[Sum]", 
   RowBox[{"i", "=", "0"}], "\[Infinity]"], 
  FractionBox["1", "i"]}]], "Output",
 CellChangeTimes->{{3.984180428571479*^9, 3.984180451235483*^9}, 
   3.984180605981155*^9, 3.984180639606642*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"8296059e-1469-43c3-b9c5-1819df2a76d1"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{{3.984180428571479*^9, 3.984180451235483*^9}, 
   3.984180605981155*^9, 3.98418063960756*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"94289833-3d9e-4c78-a6e4-90b8b4214034"]
}, Open  ]],

Cell[TextData[{
 "But, our definition of divergence says that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", "1", "+", "1", "-", "1", "+", "..."}], 
       TraditionalForm], "errors" -> {}, "input" -> "1-1+1-1+...", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c1bc6e7-855d-4f65-aed1-4b1572349a4f"],
 " is convergent, but it oscillates between 0 and 1 periodically. If we \
manipulate this sum as if it was convergent, we find that it is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox["1", "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac12", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4de94ab8-0b00-440d-986e-218ad2349065"],
 ", which can\[CloseCurlyQuote]t be, because the value if always either 0 or \
1.\nTherefore, we must change our definition of convergent to if the series \
converges to a limit as the length of the series becomes infinite. This means \
the sum above is divergent, as it does not approach to a limit.\nIf a series \
converges absolutely if it converges and if you take the absolute value of \
each term is also does."
}], "Text",
 CellChangeTimes->{{3.984330986432439*^9, 3.984331003300506*^9}, {
  3.984331410852873*^9, 3.9843315197120323`*^9}, {3.984331792746915*^9, 
  3.984331834612158*^9}},ExpressionUUID->"d9d38f1a-255c-4573-b431-\
723d5ce5c29d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sinf", "[", 
     RowBox[{"x_", ",", " ", "n_"}], "]"}], " ", "=", " ", 
    RowBox[{"SetPrecision", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "i"], 
         FractionBox[
          SuperscriptBox["x", 
           RowBox[{
            RowBox[{"2", "i"}], "+", "1"}]], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "i"}], "+", "1"}], ")"}], "!"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ",", 
      " ", "MachinePrecision"}], "]"}]}], ";"}], "                  ", 
  RowBox[{"(*", 
   RowBox[{"Taylor", " ", "series", " ", "approximation"}], "*)"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sinf", "[", 
        RowBox[{"x", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Sinf", "[", 
        RowBox[{"x", ",", " ", "10"}], "]"}], ",", " ", 
       RowBox[{"Sinf", "[", 
        RowBox[{"x", ",", " ", "10000"}], "]"}]}], "}"}], ",", " ", 
     "MachinePrecision"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "12"}], ",", " ", "12"}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{
  3.984332784911154*^9, {3.984332925023719*^9, 
   3.984332941149126*^9}},ExpressionUUID->"46202864-6da0-4afa-8146-\
648177ed3591"],

