Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "n"], "=", 
    RowBox[{
     SubscriptBox["\[Delta]", 
      RowBox[{"n", ",", "0"}]], "-", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{
       RowBox[{"(", GridBox[{
          {"n"},
          {"k"}
         }], ")"}], 
       FractionBox[
        SubscriptBox["B", "k"], 
        RowBox[{"(", 
         RowBox[{"n", "-", "k", "+", "1"}], ")"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"aca7a6b1-1c66-4b22-9940-ac92e754ca37"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta_{i,j}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b090cbe-d5dd-467d-9eab-524f6b98d13a"],
 " if i=j and 0 otherwise\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", 
     RowBox[{"2", "n"}]], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"n", "+", "1"}]], "2", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"n", "!"}]}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], 
        RowBox[{"2", "n"}]]], 
      RowBox[{
       RowBox[{"\[Zeta]", "(", 
        RowBox[{"2", "n"}], ")"}], ".", "\n", 
       SubscriptBox[
        SuperscriptBox["B", "+"], "n"]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"n\[Zeta]", "(", 
         RowBox[{"1", "-", "n"}], ")"}]}], " ", "for", " ", 
       StyleBox["n",
        FontSlant->"Italic"]}], " ", "\[GreaterEqual]", "1."}]}]}], 
   TraditionalForm]], "Input",
  FontWeight->"Plain",ExpressionUUID->"42aae654-5739-469e-9f7a-690014762d75"]
}], "Text",
 CellChangeTimes->{{3.982727622333529*^9, 3.982727657721184*^9}, {
  3.982727849207659*^9, 
  3.982727849430414*^9}},ExpressionUUID->"47d923d7-dade-45d0-8f42-\
e2a829033bb9"]
}, Closed]],

Cell[CellGroupData[{

Cell["9. Stirling Numbers", "Chapter",
 CellChangeTimes->{{3.98272782325222*^9, 
  3.9827278640719137`*^9}},ExpressionUUID->"38656cc6-9b40-41a2-8dad-\
6a1c5901c72f"],

Cell["\<\
Map problem
Suppose that there are 6 markers on a map, and they are all connected by \
exactly one edge. How many ways are there to visit each marker exactly \
once(starting point doesn\[CloseCurlyQuote]t matter)?\
\>", "Text",
 CellChangeTimes->{{3.983734609652711*^9, 
  3.983734665823441*^9}},ExpressionUUID->"0a4f9048-5ea6-4e3e-a3f0-\
406135246273"],

Cell[TextData[{
 "Stirling numbers(1st kind)\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["S", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "S_n^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9eab889-d154-4c3d-a6f0-7542751cc22f"],
 " is the number of ways to separate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b677980a-cf6d-4399-835c-4fcba4ae99ae"],
 " objects into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9ad6525-11a4-4c5d-8411-24678a610c98"],
 " cycles\nIf ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd489f6b-4ca5-403c-af1f-f3e3c4e6edb0"],
 ",  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["n", "TI"]], "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]]}}], TraditionalForm]]],
            "]"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["n", "TI"], "!"}], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}], "!"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "[\\begin{matrix}n\\\\1\\end{matrix}]=\\frac{n!}{n}=(n-1)!", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4413e36-225f-43b7-b1c4-740fda99a173"],
 "\nFor each new object, add it to an existing cycle or start a new one.\n\
Recurrence relation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["n", "TI"]], "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["k", "TI"]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], "]"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}], 
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["k", "TI"]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], "]"}], "+", 
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["k", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}}], TraditionalForm]]], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "[\\begin{matrix}n\\\\k\\end{matrix}]=(n-1)[\\begin{matrix}n-1\\\\k\\end{\
matrix}]+[\\begin{matrix}n-1\\\\k-1\\end{matrix}]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31674f13-e619-4960-9f80-ad13c91d333b"],
 "\n\nStirling numbers(2nd kind)\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["S", "TI"], 
        StyleBox["n", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "S_n^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f761605-15a3-4bd3-bca5-09f783c5ab04"],
 "(this is different) is the number of ways to partition a set of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a0ab0c3-84f2-4ccb-ba79-66d5bd1f4391"],
 " objects into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8cba396f-1be9-4df5-84b5-d5284f93bf04"],
 " subsets\nIf ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc4681a0-70fa-4d4e-9f5f-831e112dbbc3"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3582d6d3-10d0-4144-b3db-97b8a43063f1"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["n", "TI"]], "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["k", "TI"]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], "}"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{\\begin{matrix}n\\\\k\\end{matrix}\\}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d987fc0d-d3db-4af7-8e9d-90f3447ca117"],
 "\nFor each new element, add it to an existing subset or a new one.\n\
Recurrence relation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["n", "TI"]], "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["k", "TI"]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], "}"}], "\[LongEqual]", 
         StyleBox["k", "TI"], 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["k", "TI"]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], "}"}], "+", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["k", "TI"], "-", "1"}]], "InlineFormula"], 
                    " "}]]}}], TraditionalForm]]], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\{\\begin{matrix}n\\\\k\\end{matrix}\\}=k\\{\\begin{matrix}n-1\\\\k\\\
end{matrix}\\}+\\{\\begin{matrix}n-1\\\\k-1\\end{matrix}\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8d9e5aa-900c-4992-99f5-379e64f00d35"]
}], "Text",
