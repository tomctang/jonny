  UnderoverscriptBox["\[Sum]", 
   RowBox[{"i", "=", "0"}], "\[Infinity]"], "i"}]], "Output",
 CellChangeTimes->{{3.984180428571479*^9, 3.984180451235483*^9}, 
   3.984180605981155*^9, 3.984180639601922*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"6c5ff76e-092b-46a8-8e3b-11cc593598d5"],

Cell[BoxData[
 TemplateBox[{
  "Power", "infy", 
   "\"Infinite expression \\!\\(\\*FractionBox[\\\"1\\\", \\\"0\\\"]\\) \
encountered.\"", 2, 30, 5, 17119418592377876274, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
