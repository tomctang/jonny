Cell[TextData[{
 "Rising factorial: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     OverscriptBox["n", "_"]], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], 
     RowBox[{
      RowBox[{"[", GridBox[{
         {"n"},
         {"k"}
        }], "]"}], 
      SuperscriptBox["x", "k"]}]}]}], TraditionalForm]],ExpressionUUID->
  "4152064e-2a03-4431-9a3a-0fff93fe920a"],
 "\nFalling factorial: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "n"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], 
     RowBox[{
      RowBox[{"{", GridBox[{
         {"n"},
         {"k"}
        }], "}"}], 
      SuperscriptBox["x", 
       UnderscriptBox["k", "_"]]}]}]}], TraditionalForm]],ExpressionUUID->
  "e0556e88-9111-4678-afde-f4be35db8095"],
 "\n\nAs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc8aec62-0060-4925-8715-f803e5461a7a"],
 " grows without bounds for a fixed value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e49e799d-4254-4504-ad64-12e8b8d7a2c2"],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", GridBox[{
       {"n"},
       {"k"}
      }], "}"}], "\[DoubleLongRightArrow]", 
    FractionBox[
     SuperscriptBox["k", "n"], 
     RowBox[{"k", "!"}]]}], TraditionalForm]],ExpressionUUID->
  "29fc4282-cd04-49a5-b107-6c58345b6a2a"],
 "\t\nAs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc186eb4-5657-496c-a047-310371a7492b"],
 " grows without bounds for a fixed value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd790bf0-5ca8-4075-8168-07517e2876e2"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", GridBox[{
       {
        RowBox[{"n", "+", "k"}]},
       {"k"}
      }], "]"}], "\[DoubleLongRightArrow]", 
    FractionBox[
     SuperscriptBox["k", 
      RowBox[{"2", "n"}]], 
     RowBox[{
      SuperscriptBox["2", "n"], 
      RowBox[{"n", "!"}]}]]}], TraditionalForm]],ExpressionUUID->
  "527bd51e-4119-4081-b0cc-11144b999c2f"]
}], "Text",
 CellChangeTimes->{{3.983744752034546*^9, 3.983744774916952*^9}, {
  3.983745006493421*^9, 3.9837450544187107`*^9}, {3.9837450884846497`*^9, 
  3.983745089884253*^9}, {3.983745481632717*^9, 3.983745517841566*^9}, {
  3.983745577260507*^9, 
  3.983745671537212*^9}},ExpressionUUID->"2d18e4e9-9e85-49e0-9a25-\
9d9ea4628393"],

Cell[TextData[{
 "Lah numbers: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", "(", 
     RowBox[{"n", ",", "k"}], ")"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"n", "-", "1"}]},
        {
         RowBox[{"k", "-", "1"}]}
       }], ")"}], 
     FractionBox[
      RowBox[{"n", "!"}], 
      RowBox[{"k", "!"}]]}]}], TraditionalForm]],ExpressionUUID->
  "fc4faf6d-f0ef-4e6e-8173-f225a5f47340"],
 "\nThey represent the number of ways to partition a set with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bebaf763-31b9-4075-9651-04d9a7c75155"],
 " elements into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d2914b2-85e3-4fbf-8cf1-ef29ce04c604"],
 " linearly ordered subsets(every element of the subset is comparable).\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", "(", 
     RowBox[{"n", ",", "k"}], ")"}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "n"], 
     RowBox[{
      RowBox[{"[", GridBox[{
         {"n"},
         {"j"}
        }], "]"}], 
      RowBox[{"{", GridBox[{
         {"j"},
         {"k"}
        }], "}"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "23a93b7c-aa37-4593-971a-6039fda95d24"],
 "\nBell Numbers: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "n"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], 
     RowBox[{"{", GridBox[{
        {"n"},
        {"k"}
       }], "}"}]}]}], TraditionalForm]],ExpressionUUID->
  "61623769-7008-4e60-95a3-a4e7ca00b392"]
}], "Text",
 CellChangeTimes->{{3.983745809793067*^9, 3.983745861226781*^9}, {
  3.9837459223099194`*^9, 
  3.98374593734272*^9}},ExpressionUUID->"e5014810-b35d-48d7-b878-\
508ac7e66297"],

Cell[TextData[{
 "Formulae\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", GridBox[{
       {"n"},
       {"k"}
      }], "}"}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "k"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"k", "-", "j"}]], 
      FractionBox[
       SuperscriptBox["j", 
        RowBox[{"n", "-", "1"}]], 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"j", "-", "1"}], ")"}], "!"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", "-", "j"}], ")"}], "!"}]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"655bccec-535f-4bd9-9826-0db29bf8f067"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "m"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "m"], 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "k"], 
        RowBox[{"k", "!"}]}], 
       RowBox[{"k", "+", "1"}]], 
      RowBox[{"{", GridBox[{
         {"m"},
         {"k"}
        }], "}"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "146e551e-53fd-4bd7-ab98-5907df621a87"]
}], "Text",
 CellChangeTimes->{{3.983745933214197*^9, 
  3.983745941249004*^9}},ExpressionUUID->"3982b085-a030-40d8-b378-\
21f92d9b2dd1"]
}, Closed]],

