Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "m"], 
    RowBox[{"F", "(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox["f", "n"], 
      SuperscriptBox["x", 
       RowBox[{"n", "+", "m"}]]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox["f", 
       RowBox[{"n", "-", "m"}]], 
      SuperscriptBox["x", "n"]}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"af36a590-cee1-466f-a2ac-f3fad1a9ef17"]], \
"Item",
