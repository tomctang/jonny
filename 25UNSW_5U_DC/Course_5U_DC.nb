Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"coding", " ", "form"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}], "\n", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"difForward", "[", 
      RowBox[{"x", ",", "h"}], "]"}], ",", 
     RowBox[{"h", "->", "0"}]}], "]"}], "\n", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"difBackward", "[", 
      RowBox[{"x", ",", "h"}], "]"}], ",", 
     RowBox[{"h", "->", "0"}]}], "]"}], "\n", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"difCentral", "[", 
       RowBox[{"x", ",", "h"}], "]"}], ",", 
      RowBox[{"h", "->", "0"}]}], "]"}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9819125977293463`*^9, 3.981912598665037*^9}, {
  3.9819126294483213`*^9, 3.981912779844369*^9}, {3.981912843233981*^9, 
