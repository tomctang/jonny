     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "k"], 
      SuperscriptBox["x", 
       RowBox[{"2", "k"}]]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "k"}], ")"}], "!"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
