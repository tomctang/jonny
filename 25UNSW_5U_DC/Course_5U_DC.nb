Cell[TextData[StyleBox["Birthday problem (pigeonhole principle, see \
Twelvefold Way)",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.98212311326466*^9, 3.982123119346286*^9}, {
  3.9821719020220413`*^9, 3.982171914237179*^9}, {3.982172399440907*^9, 
  3.982172412890389*^9}},ExpressionUUID->"75f53241-b174-4c45-b04a-\
2c996e9fe5a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Combinations", "[", 
    RowBox[{"n_", ",", " ", "k_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"n", "!"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "k"}], ")"}], "!"}], 
      RowBox[{"k", "!"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NumberOfPairs", " ", "=", " ", 
   RowBox[{"Combinations", "[", 
    RowBox[{"40", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["364", "365"], ")"}], "NumberOfPairs"]}], ")"}], "*", 
   "100"}], "]"}]}], "Code",
 CellChangeTimes->{{3.982123127213241*^9, 3.982123225029758*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"01d8e0aa-4c75-48f9-ad8d-c38710442c78"],

Cell[BoxData["88.23356309842181`"], "Output",
 CellChangeTimes->{
  3.982123128474531*^9, {3.982123189497334*^9, 3.982123225336903*^9}},
 CellLabel->
  "Out[106]=",ExpressionUUID->"76c4079f-7a48-48c6-82d4-4dc9bdc279b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"BirthdayChance", "[", "n_", "]"}], " ", "=", 
   RowBox[{"100", "*", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"364", "/", "365"}], ")"}], "^", 
        RowBox[{"Combinations", "[", 
         RowBox[{"n", ",", " ", "2"}], "]"}]}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"BirthdayChance", "[", "n", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "2", ",", " ", "100"}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{3.9821231419745283`*^9},
 CellLabel->"In[93]:=",ExpressionUUID->"0ad32b7c-b09d-4cdb-89cc-ab3fb1dbbcb9"],

