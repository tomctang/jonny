Cell[TextData[{
 "This sequence is somewhat abstract and unintuitive, so we will go over how \
Bernoulli discovered this.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["m", "TI"]], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["m", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "S_m(n)=\\sum_{k=0}^{n-1}k^m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50c24b52-2a83-4fae-b7d6-bcdbe38e764d"]
}], "Text",
 CellChangeTimes->{{3.982726815545064*^9, 3.982726879544223*^9}, {
  3.9827269260248547`*^9, 
  3.982726926901966*^9}},ExpressionUUID->"6ace4142-3340-4cf3-9edc-\
6d7b6a66daaf"],

