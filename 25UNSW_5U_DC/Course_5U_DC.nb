      RowBox[{"n", "-", "2"}], "]"}]}]}], ",", 
   RowBox[{"f", "[", "n", "]"}], ",", "n"}], "]"}], "\n", 
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{"{", 
