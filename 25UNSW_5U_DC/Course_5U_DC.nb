Cell[CellGroupData[{

Cell["Finite Differences", "Subsubsection",
 CellChangeTimes->{{3.981912280577228*^9, 
  3.981912282568635*^9}},ExpressionUUID->"501343b0-a4cc-47ab-ac8c-\
19ef1adc0088"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"4", "x"}], "-", 
    RowBox[{"5", 
     SuperscriptBox["x", "2"]}], "+", 
    SuperscriptBox["x", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plot", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "0.5"}], ",", "4.25"}], "}"}], ",", 
    RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"difForward", "[", 
   RowBox[{"x_", ",", "h_"}], "]"}], "=", 
  FractionBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", "+", "h"}], "]"}], "-", 
    RowBox[{"f", "[", "x", "]"}]}], "h"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"difBackward", "[", 
   RowBox[{"x_", ",", "h_"}], "]"}], "=", 
  FractionBox[
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "-", 
    RowBox[{"f", "[", 
     RowBox[{"x", "-", "h"}], "]"}]}], "h"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"difCentral", "[", 
   RowBox[{"x_", ",", "a_"}], "]"}], "=", 
  FractionBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", "+", "a"}], "]"}], "-", 
    RowBox[{"f", "[", 
     RowBox[{"x", "-", "a"}], "]"}]}], 
   RowBox[{"2", "a"}]]}]}], "Code",
 CellChangeTimes->{{3.981911008603106*^9, 3.981911160281034*^9}, {
  3.98191216054673*^9, 3.981912164353801*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e59946df-e787-4a23-b61d-ddaed6711662"],

