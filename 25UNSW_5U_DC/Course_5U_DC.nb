  RowBox[{"N", "[", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"100", "!"}]], " ", "*", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"100", "!"}], ")"}], "/", "n"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "51", ",", " ", "100"}], "}"}]}], "]"}]}], 
     ")"}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.982368097930931*^9, 3.9823681050324497`*^9}, {
  3.98236830378966*^9, 
  3.982368305533152*^9}},ExpressionUUID->"0dcbfa12-2095-4f13-9284-\
