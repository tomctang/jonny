  RowBox[{"{", 
   RowBox[{"5", ",", "11", ",", "17", ",", "23", ",", "29", ",", "35"}], 
   "}"}], "]"}], "\n", 
 RowBox[{"Clear", "[", "f", "]"}], "\n", 
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "n", "]"}], "==", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"f", "[", 
         RowBox[{"n", "-", "1"}], "]"}]}], "-", 
       RowBox[{"f", "[", 
        RowBox[{"n", "-", "2"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"f", "[", "1", "]"}], "==", "5"}], ",", 
     RowBox[{
      RowBox[{"f", "[", "2", "]"}], "==", "11"}]}], "}"}], ",", 
   RowBox[{"f", "[", "n", "]"}], ",", "n"}], "]"}], "\n", 
 RowBox[{"Clear", "[", "f", "]"}], "\n", 
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "n", "]"}], "==", 
