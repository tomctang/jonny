Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"repeat", " ", "until", " ", "output", " ", "appears"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", "b"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"r", ">", "0"}], ",", 
      RowBox[{"b", "=", "r"}], ",", 
      RowBox[{"Print", "[", "a", "]"}]}], "]"}], ";"}]}]}]], "Code",
 CellChangeTimes->{{3.98193855314077*^9, 3.981938607357787*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"e30e501f-edb9-4eeb-bea1-0fe7953476e3"],

