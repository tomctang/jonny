  3.9841637130418253`*^9}},ExpressionUUID->"20e981b3-a02d-46db-8c28-\
6473b4672042"],

Cell["\<\
Convolutions are like multiplication for generating functions.\
\>", "Text",
 CellChangeTimes->{{3.984163725847*^9, 
  3.984163742877841*^9}},ExpressionUUID->"74854e96-a126-4000-9d61-\
5179bbe6f424"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"F", "(", "x", ")"}], 
    RowBox[{"G", "(", "x", ")"}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        SubscriptBox["f", "k"], 
        SubscriptBox["g", 
         RowBox[{"n", "-", "k"}]]}]}], ")"}], 
     SuperscriptBox["x", "n"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"e4290f80-b25f-41bd-9757-9fbb10394111"]], \
"Item",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.984163419056538*^9, 3.9841634322068872`*^9}, {
  3.984163504953003*^9, 3.984163562058913*^9}, {3.984163632656701*^9, 
  3.9841637149400797`*^9}, {3.98416381441206*^9, 
  3.984163814412928*^9}},ExpressionUUID->"b127ba09-b8d6-4577-bb6b-\
2d24fd8822fb"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"F", "(", "x", ")"}], 
    RowBox[{"G", "(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["f", "0"], "+", 
       RowBox[{
        SubscriptBox["f", "1"], "x"}], "+", 
       RowBox[{
        SubscriptBox["f", "2"], 
        SuperscriptBox["x", "2"]}]}], "..."}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["g", "0"], "+", 
       RowBox[{
        SubscriptBox["g", "1"], "x"}], "+", 
       RowBox[{
        SubscriptBox["g", "2"], 
        SuperscriptBox["x", "2"]}]}], "..."}], ")"}]}]}], 
  TraditionalForm]],ExpressionUUID->"2dd7781e-eb9f-4b71-acfb-a3dcc5c9a221"]], \
"Subitem",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.984163419056538*^9, 3.9841634322068872`*^9}, {
  3.984163504953003*^9, 3.984163562058913*^9}, {3.984163632656701*^9, 
  3.9841637149400797`*^9}, {3.984163814856379*^9, 
  3.984163823316575*^9}},ExpressionUUID->"d45a3a37-e47e-44c4-9757-\
75524887733b"],

Cell["This is sometimes also called the Cauchy product.", "Subitem",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.984163419056538*^9, 3.9841634322068872`*^9}, {
  3.984163504953003*^9, 3.984163562058913*^9}, {3.984163632656701*^9, 
