Cell["\<\
When Fib inputs expand from integers to continuous, use Euler\
\[CloseCurlyQuote]s formula to calculate powers.
Sage coding: def a(n): return BinaryRecurrenceSequence(1, 1).period(n)        \
   Lucas sequence is BinaryRecurrenceSequence and Fib is special Lucas\
\>", "Text",
 CellChangeTimes->{{3.982035280995305*^9, 3.9820353605507917`*^9}, 
   3.982035392639378*^9, {3.9820359862134867`*^9, 
   3.982036032286105*^9}},ExpressionUUID->"ad46db48-1a56-4211-b5f4-\
dd837b52de9c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "_"}], "}"}], "]"}], ":=", " ", 
   "False"}], ";", " ", 
  RowBox[{
   RowBox[{"test", "[", "_", "]"}], ":=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nest", "[", "k_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], "]"}], ":=", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{"b", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"a", "+", "b"}], ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"c", "+", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A001175", "[", "1", "]"}], " ", ":=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A001175", "[", "k_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"NestWhile", "[", 
     RowBox[{
      RowBox[{"nest", "[", "k", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", "test"}],
      "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"A001175", "[", "n", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", "100"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Leo", " ", 
     RowBox[{"C", ".", " ", "Stein"}]}], ",", " ", 
    RowBox[{"Nov", " ", "08", " ", "2019"}]}], " ", "*)"}]}]}], "Code",
 CellChangeTimes->{{3.982035824708634*^9, 3.982035833156802*^9}, {
  3.9820358656531076`*^9, 3.9820358842376328`*^9}},
