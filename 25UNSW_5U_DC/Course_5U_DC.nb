  3.984163660604046*^9}},ExpressionUUID->"7fdb304d-49fe-49b4-a4dd-\
4b200e8555b0"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"F", "(", 
    RowBox[{"c", " ", "x"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox["f", "n"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"c", " ", "x"}], ")"}], "n"]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox["f", "n"], 
      SuperscriptBox["c", "n"], 
      SuperscriptBox["x", "n"]}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"d6c0b619-4129-4bb7-bd27-bbf2678b16e0"]], \
