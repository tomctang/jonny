Cell[CellGroupData[{

Cell["12&13. Summing Finite & Infinite Series", "Chapter",
 CellChangeTimes->{{3.984163943001528*^9, 3.984163953177082*^9}, {
  3.9841803780229816`*^9, 
  3.984180392291692*^9}},ExpressionUUID->"1ef67c7f-aab0-4e22-8818-\
999dab1493d0"],

Cell[TextData[{
 "Summation of finite series:  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["j", "TI"], LimitsPositioning -> True], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{i=0}^j=x_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7013ec6a-457e-4c60-b679-15c56d1292d8"]
}], "Text",
 CellChangeTimes->{{3.9841729165195503`*^9, 
  3.984172952278582*^9}},ExpressionUUID->"a657c5b4-fff9-473d-b127-\
e4b0891fc308"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{"i", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "5"}], "}"}]}], "]"}]], "Code",
 CellChangeTimes->{{3.984174266238583*^9, 3.984174269174268*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"34a469a7-184d-4acb-877b-81c05d532ee5"],

Cell[BoxData["15"], "Output",
 CellChangeTimes->{3.9841742694673557`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"e58fd34d-cb6c-4ab6-b4ae-f6bb7b02bf96"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "n"], 
     RowBox[{"c", " ", 
      SubscriptBox["a", "i"]}]}], "=", 
    RowBox[{"c", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "n"], 
      SubscriptBox["a", "i"]}]}]}], TraditionalForm]],ExpressionUUID->
  "befe619a-be89-43a5-a459-45ebdb2c5bed"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "n"], 
      SubscriptBox["a", "i"]}], "+", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "n"], 
      SubscriptBox["b", "i"]}]}], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "n"], 
      SubscriptBox["a", "i"]}], "+", 
     SubscriptBox["b", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "41dde022-cbeb-417f-ac1a-56768b539086"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "n"], 
     SubscriptBox["a", "i"]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       RowBox[{"n", "-", "i"}], "=", "0"}], "n"], 
     SubscriptBox["a", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "741e7648-08ca-4c54-adc7-5505a4d612df"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"n", "+", "1"}]], 
     SubscriptBox["a", "i"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["a", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"n", "+", "1"}]], 
       SubscriptBox["a", "i"]}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "n"], 
        SubscriptBox["a", "i"]}], ")"}], "+", 
      SubscriptBox["a", 
       RowBox[{"n", "+", "1"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "17e0a400-455f-423f-ac6a-e5bb179284e5"]
}], "Text",
 CellChangeTimes->{{3.9841745809813747`*^9, 
  3.984174595596039*^9}},ExpressionUUID->"aab9dcb7-8164-450e-ac02-\
42e34d3b210b"],

Cell[TextData[{
 "Summation of arithmetic series\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "n"], "a"}], "+", 
     RowBox[{"b", " ", "i"}]}]}], TraditionalForm]],ExpressionUUID->
  "5ae5ea4f-6bf4-4a19-8757-a6daaaf1dee6"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    FractionBox[
     RowBox[{" ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "a"}], "+", 
         RowBox[{"b", " ", "n"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}]}]}], "2"]}], TraditionalForm]],
  ExpressionUUID->"fda386bc-bbcb-4664-b6fb-b16a649010ac"],
 "\nSummation of geometric series\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "n"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "n"], 
     RowBox[{"a", " ", 
      SuperscriptBox["b", "i"]}]}]}], TraditionalForm]],ExpressionUUID->
  "1ec20d1c-864c-4e01-95b3-f3ab0ec348e1"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "n"], "=", " ", 
    FractionBox[
     RowBox[{"a", "(", 
      RowBox[{
       SuperscriptBox["b", 
        RowBox[{"n", "+", "1"}]], "-", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"b", "-", "1"}], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "6ee35f35-28b0-41db-8a78-469b95e447ea"]
}], "Text",
 CellChangeTimes->{{3.984175032655613*^9, 3.984175052703508*^9}, {
  3.9841753238172073`*^9, 
  3.984175371306032*^9}},ExpressionUUID->"f007a98f-362b-46f7-9f93-\
5157ff4d0958"],

Cell[TextData[{
 "Suppose we wanted to calculate the volume of a gable house with a slanted \
roof centered at its midpoint.\nThe slope of the roof is 60 degrees and the \
house has a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"20", "\[Cross]", "20"}], TraditionalForm], "errors" -> {}, 
     "input" -> "20\\times20", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03a34745-eada-487b-961c-21933add154f"],
 " base with 10m walls."
}], "Text",
 CellChangeTimes->{{3.984175836794965*^9, 3.9841758410217257`*^9}, {
  3.984175877451663*^9, 
  3.9841759671252728`*^9}},ExpressionUUID->"f526a50b-7da1-4e85-854b-\
bb51ed2d304f"],

Cell[BoxData[{
 RowBox[{"sumVolume", " ", "=", " ", 
  RowBox[{"N", "[", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"10", "-", 
            RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "*", " ", 
          RowBox[{"Tan", "[", 
           RowBox[{"60", "*", 
            RowBox[{"(", 
             RowBox[{"\[Pi]", "/", "180"}], ")"}]}], "]"}]}], "+", "10"}], 
        ")"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y", ",", " ", 
         RowBox[{"-", "10"}], ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "10"}], ",", " ", "10"}], "}"}]}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"base", " ", "=", " ", 
   RowBox[{"20", "*", "20", "*", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"roof", " ", "=", " ", 
    RowBox[{"10", "*", 
     RowBox[{"Tan", "[", 
      RowBox[{"60", "*", 
       RowBox[{"\[Pi]", "/", "180"}]}], "]"}], " ", "*", " ", "20", "*", 
     "10"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"volume", " ", "=", " ", 
  RowBox[{"N", "[", 
   RowBox[{"base", " ", "+", " ", "roof"}], "]"}]}], "\n", 
 RowBox[{"error", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"sumVolume", " ", "-", " ", "volume"}], "]"}], "/", "volume"}], 
   " ", "*", " ", "100"}]}]}], "Code",
 CellChangeTimes->{{3.984175818698971*^9, 
  3.984175829603593*^9}},ExpressionUUID->"ccc29af2-ddc0-48a5-9797-\
4fbf9f0d4be2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Sum", "[", 
  RowBox[{"i", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Sum", "[", 
  RowBox[{
   FractionBox["1", "i"], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Sum", "[", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["2", "i"]], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{{3.984180397132317*^9, 3.984180450884143*^9}, {
  3.984180601237061*^9, 3.984180605252893*^9}, {3.984180638405929*^9, 
  3.984180639109416*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"62257954-360e-40d6-a09f-eb3f2e209607"],

