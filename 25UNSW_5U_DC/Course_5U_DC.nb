Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"only", " ", "need", " ", "to", " ", "run", " ", "once"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", "b"}], ";"}], "\n", 
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{"r", ">", "0"}], ",", 
     RowBox[{
      RowBox[{"b", "=", "r"}], ";", 
      RowBox[{"r", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{"a", ",", "b"}], "]"}]}], ";", 
      RowBox[{"a", "=", "b"}]}]}], "]"}], "\n", 
   RowBox[{"Print", "[", "a", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.981938635477928*^9, 3.9819386608218107`*^9}, {
