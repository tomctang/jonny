Cell[CellGroupData[{

Cell["11. Generating Functions", "Chapter",
 CellChangeTimes->{{3.984155063753417*^9, 
  3.984155068057721*^9}},ExpressionUUID->"640ed7bb-5d17-4df3-a19f-\
5c9105f9dcf2"],

Cell[TextData[{
 "Generating function of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["a", "TI"], "0"], ",", 
           SubscriptBox[
            StyleBox["a", "TI"], "1"], ",", 
           SubscriptBox[
            StyleBox["a", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{a_0,a_1,a_2,\\dots\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15861547-517f-4732-b45a-5393cb4d14c8"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "0"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         StyleBox["x", "TI"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "A(x)=a_0+a_1x+a_2x^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf9542c5-c96a-4c5b-b41b-7754eb6ebb39"],
 "."
}], "Text",
 CellChangeTimes->{{3.984155219486228*^9, 3.9841552392904873`*^9}, {
   3.984155270059844*^9, 3.984155274377364*^9}, 
   3.984157154240898*^9},ExpressionUUID->"0e5cd062-e150-4161-a403-\
1af159bc1ec3"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aeb5be33-8848-4b70-8b40-209aa60c5a6b"],
 " be the number of ways to tile a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[Cross]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2\\times n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "acd2678a-af71-4953-80b0-f3971e034362"],
 " grid with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[Cross]", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "2\\times1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "495db9ee-a62a-4b2b-96ef-ec9e72526ed8"],
 " dominoes.\nWe find that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "0"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_0=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fbd2356-ae2a-4e72-8757-6a0b3234d848"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "1"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_1=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "449cf109-c7b1-4b4a-bfce-6c69c35fa0eb"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "2"], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_2=2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05fe06f8-f33e-44a3-8e11-f5b0b3c337be"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "3"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_3=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d68d29ed-06c9-4945-8e07-f3ec109eae59"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "4"], "\[LongEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_4=5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42519e20-df3d-449e-8e8f-c1879bbbc2fb"],
 ".\nEach time we add new blocks, we can add 2 horizontal blocks or 1 \
vertical block.\nWe find the recurrence relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}]], "+", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "-", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "T_n=T_{n-1}+T_{n-2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8db0e2f6-287d-464d-9472-29ed14d53447"],
 ".\nThis has the same initial values and recurrence relation as the \
Fibonacci sequence, so we can say that this is the Fibonacci sequence."
}], "Text",
 CellChangeTimes->{{3.984157115799296*^9, 3.9841571479123*^9}, {
  3.984157216981442*^9, 3.984157242879466*^9}, {3.984157309605071*^9, 
  3.984157332627211*^9}, {3.984157373519286*^9, 
  3.98415748266943*^9}},ExpressionUUID->"7bcf7fe4-7c41-4eac-96b7-\
096cc517058c"],

