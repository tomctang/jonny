Cell[TextData[{
 "Recursive definition: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["B", "+"], "n"], "=", 
    RowBox[{"1", "-", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{
       RowBox[{"(", GridBox[{
          {"n"},
          {"k"}
         }], ")"}], 
       FractionBox[
        SubscriptBox["B", "k"], 
        RowBox[{"(", 
         RowBox[{"n", "-", "k", "+", "1"}], ")"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"aa4af21d-1ce6-4306-86bd-4d7f94c876ae"],
 "."
}], "Text",
 CellChangeTimes->{{3.982727085840865*^9, 
  3.982727089597253*^9}},ExpressionUUID->"106348e0-e759-43b4-acd9-\
bc372f0000f2"],

