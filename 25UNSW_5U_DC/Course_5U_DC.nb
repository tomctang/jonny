Cell[CellGroupData[{

Cell["Properties of generating functions", "Subsubsection",
 CellChangeTimes->{
  3.984163646759142*^9},ExpressionUUID->"73f1425c-073c-482d-9c3d-\
a0ea272aa59f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]F", "(", "x", ")"}], "+", 
     RowBox[{"\[Beta]G", "(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"\[Alpha]", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        SubscriptBox["f", "n"], 
        SuperscriptBox["x", "n"]}]}]}], "+", 
     RowBox[{"\[Beta]", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        SubscriptBox["g", "n"], 
        SuperscriptBox["x", "n"]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "9abf6948-f014-449d-9045-d3e726d5fbcc"],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{"f", "(", 
       RowBox[{
        RowBox[{"\[Alpha]", " ", 
         SubscriptBox["f", "n"]}], "+", 
        RowBox[{"\[Beta]", " ", 
         SubscriptBox["g", "n"]}]}], ")"}], " ", 
      SuperscriptBox["x", "n"]}]}]}], TraditionalForm]], "Item",
  ExpressionUUID->"c2252abc-f2c2-4e98-b814-9d6312683ee3"]
}], "Item",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.984163419056538*^9, 3.9841634322068872`*^9}, {
