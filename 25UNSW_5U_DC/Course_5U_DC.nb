 RowBox[{
  RowBox[{
   RowBox[{"Spherical", "[", 
    RowBox[{"r_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", "=", " ", 
   RowBox[{"r", " ", "*", " ", 
    RowBox[{"{", 
