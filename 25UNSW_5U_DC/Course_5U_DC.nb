Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     SuperscriptBox["x", "n"], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], 
      RowBox[{"G", "(", "x", ")"}]}], ")"}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "n"], 
    RowBox[{
     SubscriptBox["f", "k"], 
     SubscriptBox["g", 
      RowBox[{"n", "-", "k"}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"c52879e6-198d-499b-8fbf-6e21d2fe4a79"]], \
"Subitem",
