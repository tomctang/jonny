Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"10", "-", 
             RowBox[{"Abs", "[", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "10"}], "+", 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["20", "n"], "x"}], ")"}]}], ")"}], "]"}]}], 
            ")"}], "*", " ", 
           RowBox[{"Tan", "[", 
            RowBox[{"60", "*", 
             RowBox[{"(", 
              RowBox[{"\[Pi]", "/", "180"}], ")"}]}], "]"}]}], "+", "10"}], 
         ")"}], "*", " ", 
        RowBox[{"(", 
         FractionBox["20", "n"], ")"}], "*", "20"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], "]"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "10", ",", " ", "100", ",", " ", "1000", ",", " ", 
        "10000", ",", " ", "100000"}], "}"}]}], "}"}]}], "]"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "the", " ", "gabled", " ", "house"}], 
   "*)"}]}]], "Code",
 CellChangeTimes->{{3.984333189277173*^9, 3.984333201039382*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"f2b8a20d-9d92-49b3-a977-4f90ef215569"],

